# PostgreSQL with phpMyAdmin-style admin — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=postgres.example.com
BASE_DOMAIN_NAME=example.com

# Database superuser
DB_ADMIN_NAME=postgres
DB_ADMIN_PASS=replace-with-a-random-password
